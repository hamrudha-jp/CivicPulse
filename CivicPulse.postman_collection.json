    {
      "name": "3. Citizen Operations",
      "item": [
        {
          "name": "Submit Complaint (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.environment.set('sampleComplaintId', res.data.id);",
                  "    pm.environment.set('sampleTrackingNumber', res.data.trackingNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"Dangerous pothole near 80ft road junction\",\n  \"description\": \"Large pothole measuring approx 2 feet wide, causes severe traffic slowdown and hazard for two-wheelers.\",\n  \"severity\": \"HIGH\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946,\n  \"addressLandmark\": \"Near 80ft Road Junction, opposite Metro pillar 140\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/complaints/json",
              "host": ["{{baseUrl}}"],
              "path": ["complaints", "json"]
            }
          }
        },
        {
          "name": "Cancel Complaint (Own & SUBMITTED only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/complaints/{{sampleComplaintId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["complaints", "{{sampleComplaintId}}", "cancel"]
            }
          }
        },
        {
          "name": "Toggle Upvote (Signal community impact)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/complaints/{{sampleComplaintId}}/upvote",
              "host": ["{{baseUrl}}"],
              "path": ["complaints", "{{sampleComplaintId}}", "upvote"]
            }
          }
        },
        {
          "name": "Get Authenticated Citizen's Complaints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
