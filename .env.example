# ==============================================================================
# CivicPulse Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in this directory (or backend directory):
#    cp .env.example .env
# 2. Adjust values to match your local setup or Docker container deployment.
# 3. NEVER commit your actual .env file or production secrets to version control.
# ==============================================================================

# Backend Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
# Local Native PostgreSQL default:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/civicpulse_db
# Docker Compose Alternative (if host port 5432 is occupied by native Postgres, map to 5433):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/civicpulse_db

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT Secret Configuration
# IMPORTANT: Generate a secure 256-bit (64 hex characters) secret for production.
# Example generator: openssl rand -hex 32
APP_JWT_SECRET=replace_with_a_secure_64_character_hex_secret
APP_JWT_EXPIRATION_MS=86400000

# File Upload Directory
APP_UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker Compose Settings (used when running: docker compose up -d)
POSTGRES_DB=civicpulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password
POSTGRES_PORT=5432
